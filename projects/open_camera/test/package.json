{
  "name": "clarity-builder",
  "version": "1.0.0",
  "description": "Clarity Builder — Previz Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.claritybuilder.previz",
    "productName": "Clarity Builder",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg"
    },
    "files": [
      "index.html",
      "main.js",
      "clarity_builder.glb"
    ]
  }
}
